{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "pikuru-app",
          "appId": "1:48438281409:android:e6a2e86a50b67a1c8e4040",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "pikuru-app",
          "appId": "1:48438281409:ios:96c5f030eb9f43bd8e4040",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "pikuru-app",
          "configurations": {
            "android": "1:48438281409:android:e6a2e86a50b67a1c8e4040",
            "ios": "1:48438281409:ios:96c5f030eb9f43bd8e4040"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
